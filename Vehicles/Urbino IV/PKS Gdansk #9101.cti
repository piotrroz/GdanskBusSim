***********************************

setvar okna w szybach
0 - cala szyba // full window
1 - okno przesuwne typ 1 (prostokatne) // sliding window type 1
2 - okno przesuwne typ 2 (prostokatne duze)// sliding window type 2
3 - okno przesuwne typ 3 (okragle)// sliding window type 3
4 - okno lufcik // tilt window

[setvar]
szyba_lewa_1
0

[setvar]
szyba_lewa_2
4

[setvar]
szyba_lewa_3
0

[setvar]
szyba_lewa_4
4

[setvar]
szyba_lewa_5
4

[setvar]
szyba_prawa_1
0

[setvar]
szyba_prawa_2
0

[setvar]
szyba_prawa_3
0

[setvar]
szyba_prawa_4
4

*******
only 2 doors

[setvar]
szyba_prawa_5
0

***********************************
typ kompresora // compressor type

0 - typ 1 // type 1
1 - typ 2 // type 2

[setvar]
kompresor_typ
0

***********************************
zasieg baterii // battery range

0 - 75km
1 - 100km
2 - 150km
3 - 200km
4 - 250km

[setvar]
EV_zasieg
4

***********************************
maksymalna predkosc // max speed

0 - 70km/h
1 - 60km/h
2 - 65km/h
3 - 80km/h

[setvar]
EV_kaganiec
3

***********************************
aparatura na dachu // apparatus on the roof

0 - typ 0 // type 0
1 - typ 1 // type 1
2 - typ 2 // type 2

[setvar]
EV_zabudowa_dach
0

***********************************
przycisk od zbiorczego otwierania // button for collective door opening

0 - brak przycisku // no button
1 - przycisk prostokatny // rectangular button
2 - przycisk okragly przy przyciskach do drzwi // round button

[setvar]
zbiorczy_drzwi_typ
2

***********************************
typy drzwi // door types
0 - bode
1 - rawag
2 - ventury IST
3 - ventury -> IST, SST, IST
4 - ventury -> IST, SST, SST (only 3 doors)

[setvar]
drzwi_typ
0

***********************************
przednia szyba // front glass
0 - cala // the whole glass
1 - podzielona // split glass

[setvar]
szyba_przod_typ
0

***********************************
alarmy w drzwiach // door alarms
0 - brak // inactive
1 - sa // active

[setvar]
alarm_wtrakcie_otwierania
0

[setvar]
alarm_wtrakcie_zamykania
0

[setvar]
alarm_przed_zamknieciem
1

***********************************
alarm bez dzwieku // soundless alarm
0 - jest dzwiek // active sound
1 - brak dzwieku// inactive sound

[setvar]
bez_sygnalu_ostrzegawczego_drzwi
0

***********************************
AVAS
0 - brak // inactive
1 - typ I (tj. Krakow)
2 - typ II (tj. Poznan, Warszawa)

[setvar]
AVAS
1

***********************************
fotokomorka w drzwiach // photocell in the doors
0 - brak // inactive
1 - jest // active

[setvar]
fotokomorka
1

***********************************
typ kierownicy [DLA VDO FAP, CONTINENTAL, MVP] // Type steering wheel [FOR VDO FAP, CONTINENTAL, MVP]
0 - typ 1 (standard)
1 - typ 2 (+ with buttons)
2 - typ 3

[setvar]
kierownica_typ
0

***********************************
kabina // cabin
0 - mala // small
1 - duza // big

[setvar]
kabina_typ
0

